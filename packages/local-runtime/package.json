{
  "name": "@universal/local-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "universal-runtime": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "playwright:install": "playwright install chromium",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@7shep/universal-mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@universal/design-engine": "workspace:*",
    "@universal/generation": "workspace:*",
    "@universal/runtime-contracts": "workspace:*",
    "fonteditor-core": "^2.6.3",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3"
  }
}
