{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal.local/benchmarks/design-quality/v1/rubric.schema.json",
  "title": "Design quality rubric",
  "type": "object",
  "required": [
    "rubric_id",
    "rubric_version",
    "score_scale",
    "dimensions",
    "aggregation",
    "blind_score_format"
  ],
  "properties": {
    "rubric_id": { "const": "design-quality" },
    "rubric_version": { "type": "string", "pattern": "^1\\." },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "weight", "evidence_kind", "question"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_kind": { "enum": ["source", "rendered"] },
          "when_rendered_evidence_missing": { "enum": ["not_evaluable"] }
        },
        "allOf": [
          {
            "if": { "properties": { "evidence_kind": { "const": "rendered" } } },
            "then": {
              "required": ["when_rendered_evidence_missing"],
              "properties": {
                "weight": { "const": 0 },
                "when_rendered_evidence_missing": { "const": "not_evaluable" }
              }
            }
          }
        ]
      }
    }
  }
}
