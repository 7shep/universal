{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal.local/benchmarks/design-quality/v1/brief.schema.json",
  "title": "Design quality benchmark brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_id",
    "brief_version",
    "title",
    "surface",
    "audience",
    "scenario",
    "task",
    "content",
    "requirements",
    "constraints",
    "evaluation_focus"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "brief_id": { "type": "string", "pattern": "^dq-v1-[0-9]{2}-[a-z0-9-]+$" },
    "brief_version": { "const": "1.0.0" },
    "title": { "type": "string", "minLength": 1 },
    "surface": {
      "enum": ["landing_page", "portfolio", "product_page", "dashboard", "application"]
    },
    "audience": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "content": {
      "type": "object",
      "required": ["brand", "primary_heading", "sections"],
      "properties": {
        "brand": { "type": "string" },
        "primary_heading": { "type": "string" },
        "sections": { "type": "array", "minItems": 3, "items": { "type": "string" } }
      }
    },
    "requirements": { "type": "array", "minItems": 4, "items": { "type": "string" } },
    "constraints": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "evaluation_focus": { "type": "array", "minItems": 2, "items": { "type": "string" } }
  }
}
