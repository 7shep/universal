{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal.local/benchmarks/design-quality/v1/suite.schema.json",
  "title": "Design quality benchmark suite",
  "type": "object",
  "required": [
    "suite_id",
    "suite_version",
    "rubric_version",
    "execution_policy",
    "isolation_policy",
    "briefs",
    "arms",
    "source_evidence",
    "rendered_evidence",
    "blind_scoring"
  ],
  "properties": {
    "suite_id": { "const": "design-quality" },
    "suite_version": { "type": "string", "pattern": "^1\\." },
    "rubric_version": { "type": "string" },
    "execution_policy": {
      "type": "object",
      "required": ["budget"],
      "properties": {
        "budget": {
          "type": "object",
          "required": ["max_tokens", "max_milliseconds", "termination_grace_milliseconds"],
          "properties": {
            "max_tokens": { "type": "integer", "minimum": 1 },
            "max_milliseconds": { "type": "integer", "minimum": 1 },
            "termination_grace_milliseconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "isolation_policy": {
      "type": "object",
      "required": ["attestation_version", "required_capabilities", "unverified_status"],
      "properties": {
        "attestation_version": { "const": "1" },
        "required_capabilities": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "filesystem_isolation",
              "process_isolation",
              "network_isolation",
              "host_isolation",
              "tool_isolation"
            ]
          }
        },
        "unverified_status": { "const": "not_comparable" }
      }
    },
    "briefs": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^briefs/.+\\.json$" }
    },
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "brief_input", "workflow"],
        "properties": {
          "id": { "enum": ["unguided", "universal_guided"] }
        }
      }
    },
    "rendered_evidence": {
      "type": "object",
      "required": ["available", "missing_status", "missing_score"],
      "properties": {
        "available": { "const": false },
        "missing_status": { "const": "not_evaluable" },
        "missing_score": { "type": "null" }
      }
    }
  }
}
